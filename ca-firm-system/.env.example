# =============================================================================
# CA Firm System - local development environment template
# Copy to .env and replace EVERY value marked CHANGE_ME. Never commit .env.
# Passwords used inside connection URLs must be URL-safe (letters/digits/-_.~).
# =============================================================================

# local | test | staging | production
APP_ENV=local
LOG_LEVEL=INFO

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=cafirm
POSTGRES_DB=cafirm
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# --- MinIO (S3-compatible object storage; dev only) --------------------------
MINIO_ROOT_USER=CHANGE_ME
# minimum 8 characters
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=ca-firm-files

# --- LiteLLM Proxy -----------------------------------------------------------
# Master key is server-side only. Phase 4 replaces backend use with a scoped virtual key.
# must start with "sk-" for LiteLLM, e.g. sk-<random>
LITELLM_MASTER_KEY=CHANGE_ME
# Provider keys are read ONLY by the litellm container. Leave blank until needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Kafka (KRaft) -----------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Backend -----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Authentication (Phase 1) --------------------------------------------------
# Signs access tokens (HS256). Server-side only. MUST be >= 32 chars; generate with:
#   openssl rand -hex 32
# Rotating it signs everyone out. Never reuse across environments.
JWT_SECRET=CHANGE_ME
# Refresh-cookie "Secure" flag. false is for http://localhost only; MUST be true behind TLS
# (the backend refuses to start in staging/production with false).
COOKIE_SECURE=false
# Optional overrides (defaults shown): access 15 min, refresh 7 days, lock after 5 bad logins for 15 min
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# --- Uploads / object storage (Phase 2) -----------------------------------------
# Max size of one uploaded file in bytes (default 52428800 = 50 MiB). Keep nginx
# client_max_body_size (infrastructure/nginx/nginx.conf) above this.
# MAX_UPLOAD_BYTES=52428800
# Comma-separated allowed extensions (content is verified against the extension).
# ALLOWED_UPLOAD_EXTENSIONS=pdf,xlsx,xls,csv,png,jpg,jpeg
# Set false only if you run the outbox relay elsewhere; file.uploaded events are sent by it.
# OUTBOX_RELAY_ENABLED=true

# --- Host port bindings (all bound to 127.0.0.1 only) ------------------------
NGINX_HOST_PORT=8080
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
KAFKA_EXTERNAL_PORT=29092
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
LITELLM_HOST_PORT=4000
WORKER_HEALTH_HOST_PORT=8001
